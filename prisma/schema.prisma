// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/** Agencia / marca en la plataforma. Default: universo-nomada (web pública sin cambios). */
model Tenant {
  id         String   @id
  name       String
  slug       String   @unique
  configJson String   @default("{}")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String?
  /** user | admin | ops | finance | marketing */
  role            String    @default("user")
  tenantId        String    @default("universo-nomada")
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  leads           Lead[]    @relation("LeadOwner")
  assignedLeads   Lead[]    @relation("LeadAssignee")
  leadNotes       LeadNote[]
  passportBadges  UserPassportBadge[]

  @@index([tenantId])
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model NomadBenefit {
  id              Int      @id @default(autoincrement())
  tenantId        String   @default("universo-nomada")
  brandName       String
  title           String
  description     String   @default("")
  instructions    String   @default("")
  image           String   @default("")
  couponCode      String   @default("")
  discountLabel   String   @default("")
  restrictionType String   @default("none")
  restrictionDays Int?
  restrictionNote String   @default("")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model BenefitPartnerLogo {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("universo-nomada")
  name      String   @default("")
  imageUrl  String
  linkUrl   String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model PassportBadge {
  id          Int      @id @default(autoincrement())
  tenantId    String   @default("universo-nomada")
  slug        String   @unique
  name        String
  destination String   @default("")
  description String   @default("")
  image       String   @default("")
  emoji       String   @default("🌍")
  matchTerms  String   @default("[]")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  awards      UserPassportBadge[]

  @@index([tenantId])
}

/** Insignia ganada por un miembro al completar un viaje. */
model UserPassportBadge {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   Int
  badge     PassportBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  leadId    Int?
  earnedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id            Int       @id @default(autoincrement())
  tenantId      String    @default("universo-nomada")
  userId        String?
  user          User?     @relation("LeadOwner", fields: [userId], references: [id])
  assignedToUserId String?
  assignedTo    User?     @relation("LeadAssignee", fields: [assignedToUserId], references: [id])
  nombre        String
  email         String
  telefono      String
  destino       String?
  mensaje       String?
  status        String    @default("nuevo")
  source        String    @default("web")
  referralCode  String?
  paymentMethod String?
  paymentPlan   String?
  cartTotal     Int?
  /** Monto YA PAGADO (abonos). En checkout transferencia pendiente = monto a transferir hasta confirmar. Preferir LeadPayment. */
  amountDue     Int?
  expiresAt     DateTime?
  tripEndDate   DateTime?
  googleReviewRequestAt DateTime?
  sumupCheckoutId       String?
  confirmationEmailSentAt DateTime?
  transferReminder5hAt  DateTime?
  cartJson              String?
  discountCode          String?
  discountAmount        Int?
  rouletteSpinId        Int?
  roulettePrize         String?
  rouletteGiftTour      String?
  documents             TripDocument[]
  payments              LeadPayment[]
  notes                 LeadNote[]
  events                LeadEvent[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([tenantId])
  @@index([assignedToUserId])
}

model LeadNote {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadEvent {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  message   String   @default("")
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([leadId])
}

/** Abonos / pagos parciales de una reserva (Lead). amountDue en Lead = suma de estos (monto ya pagado). */
model LeadPayment {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  amount    Int
  paidAt    DateTime @default(now())
  method    String   @default("transferencia")
  note      String   @default("")
  /** ID externo pasarela (SumUp/MP/TBK) para conciliación */
  externalId String  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([externalId])
}

model TripDocument {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  docType   String
  label     String   @default("")
  fileUrl   String
  fileName  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
}

model RouletteSpin {
  id        Int       @id @default(autoincrement())
  tenantId  String    @default("universo-nomada")
  email     String    @unique
  nombre    String
  telefono  String    @default("")
  prize     String
  redeemed  Boolean   @default(false)
  expiresAt DateTime
  leadId    Int?
  createdAt DateTime  @default(now())

  @@index([tenantId])
}

model DiscountCode {
  id            Int       @id @default(autoincrement())
  tenantId      String    @default("universo-nomada")
  code          String    @unique
  description   String    @default("")
  discountType  String    @default("percent")
  discountValue Int
  active        Boolean   @default(true)
  /** Si true, cada correo solo puede usarlo en una reserva. */
  oncePerEmail  Boolean   @default(false)
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
}

model Promotion {
  id            Int      @id @default(autoincrement())
  tenantId      String   @default("universo-nomada")
  title         String
  subtitle      String
  discount      String
  destination   String
  validUntil    String
  originalPrice Int
  discountPrice Int
  emoji         String   @default("🔥")
  image         String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model Tour {
  tourId            String   @id
  tenantId          String   @default("universo-nomada")
  name              String
  subtitle          String
  description       String   @default("")
  image             String
  tag               String   @default("")
  category          String   @default("chile")
  price             Int
  originalPrice     Int?
  duration          String   @default("")
  includesText      String   @default("")
  excludesText      String   @default("")
  highlightsText    String   @default("")
  pdfUrl            String   @default("")
  galleryJson       String   @default("[]")
  faqJson           String   @default("[]")
  optionalToursJson String   @default("{\"pickCount\":0,\"options\":[]}")
  flightOrigin      String   @default("SCL")
  flightDestination String   @default("")
  flightBudgetMax   Int?
  taxType              String   @default("exento")
  minDepositPerPerson  Int      @default(0)
  /** Visible en la sección Ofertas de la home */
  showInOfertas        Boolean  @default(false)
  /** Título de la oferta (el nombre del programa pasa a subtítulo) */
  promoTitle           String   @default("")
  /** % OFF de oferta: se aplica a todos los hoteles y ocupaciones (1/2/3+) */
  promoDiscountPercent Int      @default(0)
  /** Inicio programado de la oferta (hora Chile). Null = ya está vigente. */
  promoStartsAt        DateTime?
  /** Término programado: al llegar a esta hora sale de Ofertas y vuelve el precio real. */
  promoEndsAt          DateTime?
  active               Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

model InstagramPost {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("universo-nomada")
  postUrl   String
  caption   String   @default("")
  imageUrl  String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("universo-nomada")
  imageUrl  String
  label     String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  /** Inicio programado (hora Chile). Null = visible desde ya si active. */
  startsAt  DateTime?
  /** Término: al llegar a esta hora se oculta solo. */
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model BlogArticle {
  id           Int      @id @default(autoincrement())
  tenantId     String   @default("universo-nomada")
  slug         String   @unique
  titleJson    String
  excerptJson  String
  contentJson  String
  categoryJson String
  image        String   @default("")
  date         String
  readTime     Int      @default(5)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model BlogSubscriber {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("universo-nomada")
  email     String   @unique
  source    String   @default("blog")
  marketingConsent Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

/** Comentarios / opiniones del blog público (moderación manual; no se publican solos). */
model BlogComment {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("universo-nomada")
  postSlug  String
  postTitle String   @default("")
  name      String
  email     String
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, postSlug])
  @@index([createdAt])
}

model TourPricing {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("universo-nomada")
  tourId    String   @unique
  tourName  String
  basePrice Int
  tiersJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model GroupTrip {
  id                 Int              @id @default(autoincrement())
  tenantId           String           @default("universo-nomada")
  tourId             String           @unique
  name               String
  duration           String
  image              String
  gradient           String           @default("from-teal-500 to-cyan-600")
  reservation        Int              @default(100000)
  price              Int
  includesJson       String           @default("[]")
  /** [{ day, title, description, activities[], image, meals: { breakfast, lunch, dinner, cocktail } }] */
  itineraryJson      String           @default("[]")
  /** [{ id, name, description, image }] */
  accommodationsJson String           @default("[]")
  active             Boolean          @default(true)
  sortOrder          Int              @default(0)
  departures         GroupDeparture[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([tenantId])
}

model GroupDeparture {
  id                  Int       @id @default(autoincrement())
  groupTripId         Int
  date                String
  spotsLeft           Int       @default(0)
  totalSpots          Int       @default(0)
  /** available | last_spots | sold_out */
  availabilityStatus  String    @default("available")
  groupTrip           GroupTrip @relation(fields: [groupTripId], references: [id], onDelete: Cascade)
}

model SiteContent {
  key       String   @id
  tenantId  String   @default("universo-nomada")
  json      String
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model CartAbandonment {
  id          Int       @id @default(autoincrement())
  tenantId    String    @default("universo-nomada")
  email       String    @unique
  nombre      String    @default("")
  telefono    String    @default("")
  cartJson    String
  cartTotal   Int       @default(0)
  reminder1At     DateTime?
  reminderPrizeAt DateTime?
  reminder2At     DateTime?
  convertedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
}
