// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String?
  role            String    @default("user")
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  leads           Lead[]
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model NomadBenefit {
  id              Int      @id @default(autoincrement())
  brandName       String
  title           String
  description     String   @default("")
  instructions    String   @default("")
  image           String   @default("")
  couponCode      String   @default("")
  discountLabel   String   @default("")
  restrictionType String   @default("none")
  restrictionDays Int?
  restrictionNote String   @default("")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BenefitPartnerLogo {
  id        Int      @id @default(autoincrement())
  name      String   @default("")
  imageUrl  String
  linkUrl   String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PassportBadge {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  destination String   @default("")
  description String   @default("")
  image       String   @default("")
  emoji       String   @default("🌍")
  matchTerms  String   @default("[]")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id            Int       @id @default(autoincrement())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  nombre        String
  email         String
  telefono      String
  destino       String?
  mensaje       String?
  status        String    @default("nuevo")
  source        String    @default("web")
  referralCode  String?
  paymentMethod String?
  paymentPlan   String?
  cartTotal     Int?
  amountDue     Int?
  expiresAt     DateTime?
  tripEndDate   DateTime?
  googleReviewRequestAt DateTime?
  sumupCheckoutId       String?
  confirmationEmailSentAt DateTime?
  transferReminder5hAt  DateTime?
  cartJson              String?
  discountCode          String?
  discountAmount        Int?
  rouletteSpinId        Int?
  roulettePrize         String?
  rouletteGiftTour      String?
  documents             TripDocument[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

model TripDocument {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  docType   String
  label     String   @default("")
  fileUrl   String
  fileName  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
}

model RouletteSpin {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  nombre    String
  telefono  String    @default("")
  prize     String
  redeemed  Boolean   @default(false)
  expiresAt DateTime
  leadId    Int?
  createdAt DateTime  @default(now())
}

model DiscountCode {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  description   String    @default("")
  discountType  String    @default("percent")
  discountValue Int
  active        Boolean   @default(true)
  /** Si true, cada correo solo puede usarlo en una reserva. */
  oncePerEmail  Boolean   @default(false)
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Promotion {
  id            Int      @id @default(autoincrement())
  title         String
  subtitle      String
  discount      String
  destination   String
  validUntil    String
  originalPrice Int
  discountPrice Int
  emoji         String   @default("🔥")
  image         String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Tour {
  tourId            String   @id
  name              String
  subtitle          String
  description       String   @default("")
  image             String
  tag               String   @default("")
  category          String   @default("chile")
  price             Int
  originalPrice     Int?
  duration          String   @default("")
  includesText      String   @default("")
  excludesText      String   @default("")
  highlightsText    String   @default("")
  pdfUrl            String   @default("")
  galleryJson       String   @default("[]")
  faqJson           String   @default("[]")
  optionalToursJson String   @default("{\"pickCount\":0,\"options\":[]}")
  flightOrigin      String   @default("SCL")
  flightDestination String   @default("")
  flightBudgetMax   Int?
  taxType              String   @default("exento")
  minDepositPerPerson  Int      @default(0)
  /** Visible en la sección Ofertas de la home */
  showInOfertas        Boolean  @default(false)
  /** Título de la oferta (el nombre del programa pasa a subtítulo) */
  promoTitle           String   @default("")
  /** % OFF de oferta: se aplica a todos los hoteles y ocupaciones (1/2/3+) */
  promoDiscountPercent Int      @default(0)
  active               Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InstagramPost {
  id        Int      @id @default(autoincrement())
  postUrl   String
  caption   String   @default("")
  imageUrl  String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  label     String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogArticle {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  titleJson    String
  excerptJson  String
  contentJson  String
  categoryJson String
  image        String   @default("")
  date         String
  readTime     Int      @default(5)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BlogSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  source    String   @default("blog")
  marketingConsent Boolean @default(false)
  createdAt DateTime @default(now())
}

model TourPricing {
  id        Int      @id @default(autoincrement())
  tourId    String   @unique
  tourName  String
  basePrice Int
  tiersJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupTrip {
  id           Int              @id @default(autoincrement())
  tourId       String           @unique
  name         String
  duration     String
  image        String
  gradient     String           @default("from-teal-500 to-cyan-600")
  reservation  Int              @default(100000)
  price        Int
  includesJson String           @default("[]")
  active       Boolean          @default(true)
  sortOrder    Int              @default(0)
  departures   GroupDeparture[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model GroupDeparture {
  id                  Int       @id @default(autoincrement())
  groupTripId         Int
  date                String
  spotsLeft           Int       @default(0)
  totalSpots          Int       @default(0)
  /** available | last_spots | sold_out */
  availabilityStatus  String    @default("available")
  groupTrip           GroupTrip @relation(fields: [groupTripId], references: [id], onDelete: Cascade)
}

model SiteContent {
  key       String   @id
  json      String
  updatedAt DateTime @updatedAt
}

model CartAbandonment {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  nombre      String    @default("")
  telefono    String    @default("")
  cartJson    String
  cartTotal   Int       @default(0)
  reminder1At     DateTime?
  reminderPrizeAt DateTime?
  reminder2At     DateTime?
  convertedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
