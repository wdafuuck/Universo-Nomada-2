# ═══════════════════════════════════════════════════════════════
# Universo Nómada — Variables de entorno
# Copia a .env y completa los valores. NUNCA subas .env a git.
# ═══════════════════════════════════════════════════════════════

# ── Base ──────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Desarrollo local (SQLite). Producción: PostgreSQL — ver DEPLOY.md
DATABASE_URL=file:./prisma/dev.db

# Sesión (mín. 32 chars en producción): openssl rand -base64 48
SESSION_SECRET=

# Cron emails (Vercel cron / crontab): openssl rand -hex 32
CRON_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Universo Nómada <contacto@universonomada.cl>"

# ── Pagos ──────────────────────────────────────────────────────
# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# SumUp
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Transbank (Webpay Plus)
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENV=integration

# ── Google ─────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Universo Nómada agencia de viajes Chile
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://share.google/DyUlJi938LkoVosKT
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# SEO verificación (opcional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow (opcional)
INDEXNOW_KEY=

# ── Vuelos / Hoteles (opcional) ───────────────────────────────
LITEAPI_API_KEY=
RATEHAWK_API_KEY=
BOOKING_API_KEY=

# ── Analytics ─────────────────────────────────────────────────
# Ya definidos arriba: NEXT_PUBLIC_GA_ID, NEXT_PUBLIC_META_PIXEL_ID
