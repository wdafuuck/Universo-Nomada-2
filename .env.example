# ═══════════════════════════════════════════════════════════════
# Universo Nómada — Variables de entorno
# Copia a .env y completa los valores. NUNCA subas .env a git.
# ═══════════════════════════════════════════════════════════════

# ── Base ──────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Desarrollo local (SQLite). Producción: PostgreSQL — ver DEPLOY.md
DATABASE_URL=file:./prisma/dev.db

# Sesión (mín. 32 chars en producción): openssl rand -base64 48
SESSION_SECRET=

# Cron emails (Vercel cron / crontab): openssl rand -hex 32
CRON_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Universo Nómada <contacto@universonomada.cl>"

# ── Pagos ──────────────────────────────────────────────────────
# Ambas pasarelas activas a la vez:
#   Internacional (exento) → solo SumUp
#   Nacional (afecto) → el cliente elige SumUp o Mercado Pago
# PAYMENT_PROVIDER es solo fallback.
# PAYMENT_PROVIDER=sumup

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Secreto de Webhooks (Tu integración → Webhooks → Configurar). Si está vacío, no se valida firma.
MERCADOPAGO_WEBHOOK_SECRET=

# SumUp
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Transbank (Webpay Plus)
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENV=integration

# ── Google ─────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Universo Nómada agencia de viajes Chile
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://share.google/DyUlJi938LkoVosKT
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads (opcional): ID de conversión AW-XXXXXXXXX — se conecta vía GTM
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Asistente SEO admin (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GA4 Data API (usuarios en vivo en Admin → Tráfico & SEO)
# 1) En Google Cloud: crear Service Account + clave JSON
# 2) En GA4 → Admin → Gestión de acceso: Viewer al email de la SA
# 3) Activar "Google Analytics Data API"
# 4) GA4_PROPERTY_ID = ID numérico de la propiedad (Admin → Ajustes de la propiedad)
GA4_PROPERTY_ID=
# JSON completo en una línea (o usar GOOGLE_APPLICATION_CREDENTIALS=/ruta/sa.json)
GA4_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=

# SEO verificación (opcional)
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow (opcional)
INDEXNOW_KEY=

# ── Plataforma (sin impacto visual público) ───────────────────
# TENANT_ID=universo-nomada
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# FEATURE_ROULETTE=true
# FEATURE_ABANDONED_CART=true
# FEATURE_PAYMENT_RECONCILIATION=true
# FEATURE_CHANNEL_MANAGER_STUB=true

# ── Vuelos / Hoteles (opcional) ───────────────────────────────
LITEAPI_API_KEY=
RATEHAWK_API_KEY=
BOOKING_API_KEY=

# ── Analytics ─────────────────────────────────────────────────
# Preferir GTM (NEXT_PUBLIC_GTM_ID=GTM-XXXX).
# Con GTM activo, GA4/Meta directos siguen cargando hasta que pongas
# NEXT_PUBLIC_ANALYTICS_GTM_ONLY=true (luego configuras esos tags solo en GTM).
NEXT_PUBLIC_ANALYTICS_GTM_ONLY=
